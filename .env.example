# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | groq | gemini | anthropic
# Groq uses the OpenAI Python SDK with its OpenAI-compatible endpoint.
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
OPENAI_BASE_URL=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional services
PAGEINDEX_API_KEY=
PAGEINDEX_FONT_PATH=
JINA_API_KEY=

# Ngưỡng khởi điểm; hiệu chỉnh bằng query in-domain và out-of-domain.
SCORE_THRESHOLD=0.5731
